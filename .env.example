# Copy this file to .env before running:  cp .env.example .env
# Every value here is a safe development default.

# Secret key for the HMAC-SHA256 patient_key pseudonymisation.
# DEVELOPMENT-ONLY VALUE — never use this key in production; real keys live in
# a secret manager and are injected at deploy time.
PATIENT_KEY_SECRET=dev-only-hmac-key-0f4c81-do-not-use-in-production

# Publish gate: a batch with more than this share of error-level rows is not
# published to the analytical layer (0.10 = 10%).
PUBLISH_GATE_THRESHOLD=0.10

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
