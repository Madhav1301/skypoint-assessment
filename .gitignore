# secrets — never commit real keys
.env

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# local tooling / IDE
.vscode/
.idea/

# generated outputs are ignored during development;
# the final submission commits them (remove the two lines below at release)
output/*
!output/.gitkeep

# local database files anywhere else
*.duckdb
*.duckdb.wal
